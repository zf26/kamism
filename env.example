# ─── 数据库 ──────────────────────────────────────────
# PostgreSQL 密码（自动创建 kamism 数据库和用户）请不要包含特殊字符
POSTGRES_PASSWORD=change_me_strong_password

# ─── RabbitMQ ────────────────────────────────────────
#  请不要包含特殊字符
RABBITMQ_PASSWORD=change_me_rabbitmq_password

# ─── 认证 ────────────────────────────────────────────
# JWT 签名密钥。**必填**：至少 32 位，且不能是占位符 ——
# 留空、或照抄本文件的示例值，后端会**拒绝启动**（刻意如此）。
# 原因：这个值可预测的话，任何人都能伪造出任意用户的 token，
#       而运行时完全看不出异常（签发、校验都「正常」）。
# 生成方式：openssl rand -hex 32
JWT_SECRET=
# 加密主密钥：AES-256-GCM 的主密钥，必须是 64 个十六进制字符（32 字节）
# 生成方式：openssl rand -hex 32
#
# ⚠️ 这个值必须固定保存、永不变更：
#   换了密钥 / 丢了密钥 = 已加密字段（商户 API Key、邮箱、卡密、设备 ID）
#   全部永久无法解密。所以：
#   - 首次部署前就要填好（不要留空上生产，留空只会临时生成一把、重启即失效）；
#   - 格式非法（比如把下面这行说明文字留在等号后面）会直接拒绝启动，
#     这是刻意的：宁可启动失败，也不要带着一把新密钥去读旧数据。
MASTER_KEY=

# 反向代理信任范围（逗号分隔的 IP 或 CIDR）
#
# ⚠️ 部署在 Nginx 之后时**必须**配置，否则：
#   1) 所有请求的来源 IP 都会被算成 Nginx 的地址 → 限流额度退化成「全站共用一份」
#      （登录 10 次/分钟、公开 API 60 次/分钟被所有用户抢）；
#   2) IP 黑名单认不出真实客户端，风控形同虚设；
#   3) 激活记录里的 IP 全是 127.0.0.1，商户后台「客户 IP 分布」地图永远是空的。
# 留空 = 谁都不信任，转发头（X-Forwarded-For / X-Real-IP）一律忽略 —— 这是安全默认值。
#
# 取值只看「谁在同后端建立 TCP 连接」，不要照抄别处的值：
#   · docker compose 多容器（Nginx 是独立容器）：172.28.0.0/16
#       —— 必须与 docker-compose.yml 末尾钉死的 subnet 一致，改网段时两处同步；
#   · docker compose 单容器（standalone，Nginx 与后端同容器）：127.0.0.1
#   · 非 Docker、Nginx 与后端同机：127.0.0.1
#   · Nginx 在另一台机器：填那台机器的出口 IP
#   · 前面还有 CDN：把 CDN 回源网段也加进来，否则记录到的是 CDN 的 IP
# 只写真正会转发请求的那一段。写大了（如 172.16.0.0/12）等于信任了一批不该信任的地址，
# X-Forwarded-For 就有了伪造空间。
#
# 验证：重启后日志应出现「客户端 IP 策略: 已信任 N 条代理网段（TRUSTED_PROXIES=...）」。
# 若出现「未配置 TRUSTED_PROXIES」的 WARN，或激活记录里 IP 是 127.0.0.1，
# 说明这项没生效 —— 排查步骤见 docs/fix-client-ip.md
TRUSTED_PROXIES=172.28.0.0/16,127.0.0.1

# Oauth2 授权后回调地址（开启oauth2认证时填写,默认为http://localhost:1420）
FRONTEND_URL=http://localhost:1420

# ─── 管理员账号（仅当库里还没有任何管理员时才创建）────
# ADMIN_PASSWORD 同样必填（只在上面的条件成立时才要求）：
#   至少 12 位；不能是常见公开口令（Admin@123456 这类会被拒绝）；
#   24 位以上随机串最省事。生成方式：openssl rand -hex 24
# 留空且库里没有管理员 → 后端拒绝启动，而不是静默建一个默认口令的账号。
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ─── 端口（可选）─────────────────────────────────────
# 前端访问端口（默认 1420），后端不对外暴露
FRONTEND_PORT=1420

# ─── 邮件服务（可选，不填则禁用邮件功能）──────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM_NAME=KamiSM
SMTP_FROM_EMAIL=noreply@example.com

# ─── 支付通道 ──────────────────────────────────────────
# 支持 xorpay 和 mbdpay（0 手续费，推荐），默认 mbdpay
PAY_CHANNEL=mbdpay

# MbdPay（https://p.mbd.pub 申请）
MBD_APP_ID=
MBD_APP_KEY=
MBD_NOTIFY_URL=https://yourdomain.com/api/pay/notify

# XorPay（https://xorpay.com 申请）
XORPAY_AID=
XORPAY_APP_KEY=
XORPAY_NOTIFY_URL=https://yourdomain.com/api/pay/notify

# ─── 日志级别 ─────────────────────────────────────────
# 可选: error, warn, info, debug, trace
RUST_LOG=info
